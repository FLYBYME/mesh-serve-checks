{
    "name": "@flybyme/mesh-serve-checks",
    "version": "0.1.0",
    "description": "Live checks for a mesh-serve api: small scenarios that do what a person does, against the real thing, and clean up after themselves.",
    "type": "module",
    "license": "MIT",
    "bin": {
        "mesh-serve-checks": "./bin/mesh-serve-checks.mjs"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "mesh-source": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p .",
        "test": "npm run typecheck && vitest run"
    },
    "dependencies": {
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    },
    "engines": {
        "node": ">=22"
    }
}
